  "rationale": "Prefix branches constrain the next letter while visited cells are local to one path; a found word can be a prefix of another and must not stop deeper exploration.",
  "commonMistakes": [
    "reuse-board-cells-in-one-path",
    "stop-after-short-terminal-word",
    "return-duplicates-in-dictionary-order"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
    "outputBytes": 4194304,
    "fileKb": 4096,
    "inputBytes": 8388608
  },
  "semanticConstraints": [
    {
      "kind": "rectangular-strings",
      "field": "board",
      "minColumns": 1,
      "maxColumns": 4,
      "maxRows": 4
    },
    {
      "kind": "alphabet",
      "field": "board",
      "alphabet": "lowercase",
      "each": true
    },
    {
      "kind": "alphabet",
      "field": "words",
      "alphabet": "lowercase",
      "each": true
    }
  ]
