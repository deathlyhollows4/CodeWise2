{
  "schemaVersion": 1,
  "id": "heap-04",
  "version": "1.0.0",
  "slug": "closest-origin-points",
  "title": "The closest k points to the origin",
  "primaryTopic": "heap",
  "skillIds": [
    "heap.bounded-frontier",
    "heap.distance-frontier",
    "geometry.squared-distance"
  ],
  "prerequisites": [
    "arrays.traversal",
    "numbers.wide-intermediates"
  ],
  "step": 2,
  "status": "draft",
  "objective": "Select the closest k point positions by exact squared Euclidean distance with deterministic coordinate ties.",
  "constraints": [
    "0 <= points.length <= 30000",
    "0 <= k <= points.length",
    "Each coordinate is an integer in [-1000000,1000000].",
    "Squared distances can exceed signed 32 bit range."
  ],
  "interface": "Solution.solve(points, k) receives a typed point matrix and selection count.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "points": {
        "kind": "array",
        "maxLength": 30000,
        "unordered": true,
        "items": {
          "kind": "array",
          "minLength": 2,
          "maxLength": 2,
          "items": {
            "kind": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        }
      },
      "k": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 30000
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 30000,
    "items": {
      "kind": "array",
      "minLength": 2,
      "maxLength": 2,
      "items": {
        "kind": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
