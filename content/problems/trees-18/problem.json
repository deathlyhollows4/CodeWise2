{
  "schemaVersion": 1,
  "id": "trees-18",
  "version": "2.0.0",
  "slug": "perform-one-specified-native-root-rotation",
  "title": "Rotate the root once",
  "primaryTopic": "trees",
  "skillIds": [
    "trees.child-links",
    "trees.root-rotation",
    "trees.inorder-preservation"
  ],
  "prerequisites": [
