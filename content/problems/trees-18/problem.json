  "step": 2,
  "status": "published",
  "objective": "Perform one specified root rotation, preserving the entire inorder value sequence and all unaffected subtree structure.",
  "constraints": [
    "0 ≤ native node count ≤ 2,000.",
    "Every node value lies in [-1,000,000,000,1,000,000,000]; duplicate values are allowed.",
    "The input is a finite arbitrary binary tree; it need not satisfy BST value ordering.",
    "direction is exactly LEFT or RIGHT.",
    "The result must match the specified single-root topology, not merely any tree with the same inorder sequence.",
    "You may relink or allocate a new result; only result values and topology are required, not original identities or immutability."
  ],
  "interface": "Solution.solve(root:TreeNode,direction:string) returns a native TreeNode; display output is compact breadth-first values.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      },
      "direction": {
        "kind": "enum",
        "values": [
          "LEFT",
          "RIGHT"
        ]
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 4001,
    "trimTrailingNulls": true,
    "items": {
      "kind": "nullable",
      "value": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
