  ],
  "rationale": "Two traversal speeds reveal a cycle; resetting one cursor identifies its entry. Equal-valued nodes and permuted storage prevent value/index shortcuts.",
  "commonMistakes": [
    "return-meeting-without-reset",
    "first-equal-value-node"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
    "outputBytes": 4194304,
    "fileKb": 4096,
    "inputBytes": 8388608
  },
  "semanticConstraints": [
    {
      "kind": "node-table",
      "field": "data",
      "links": [
        "next"
      ],
      "heads": "heads",
      "requireReachable": true
    }
  ]
}
