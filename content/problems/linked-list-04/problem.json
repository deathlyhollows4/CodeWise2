{
  "schemaVersion": 1,
  "id": "linked-list-04",
  "version": "1.0.0",
  "slug": "cycle-entry-original-node",
  "title": "Find where the cycle begins",
  "primaryTopic": "linked-list",
  "skillIds": [
    "list.cycle-meeting",
    "list.cycle-entry",
    "list.original-identity"
  ],
  "prerequisites": [
    "list.walk"
  ],
  "step": 2,
  "status": "published",
  "objective": "Distinguish a cycle meeting point from its entry and return the exact original entry node.",
  "constraints": [
    "0 ≤ data.values.length ≤ 2,000",
    "next has one nullable bounded node index per value; heads contains exactly one nullable bounded index.",
    "All nodes are reachable from the single head; the links may form a cycle.",
    "Values lie in [-1,000,000,1,000,000] and may all be equal."
  ],
  "interface": "Solution.solve(data) receives IdentityList and returns an original ListNode or null.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "data": {
        "kind": "object",
        "properties": {
          "values": {
            "kind": "array",
            "maxLength": 2000,
            "items": {
              "kind": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "next": {
            "kind": "array",
            "maxLength": 2000,
            "items": {
              "kind": "nullable",
              "value": {
                "kind": "integer",
                "minimum": 0,
                "maximum": 1999
              }
            }
          },
          "heads": {
            "kind": "array",
            "minLength": 1,
            "maxLength": 1,
            "items": {
              "kind": "nullable",
              "value": {
                "kind": "integer",
                "minimum": 0,
                "maximum": 1999
              }
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "nullable",
    "value": {
      "kind": "integer",
      "minimum": 0,
      "maximum": 1999
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
    "cpp": {
      "starter": "languages/cpp/starter.cpp",
      "wrapper": "languages/cpp/wrapper.cpp",
      "reference": "languages/cpp/reference.cpp"
    },
    "python": {
      "starter": "languages/python/starter.py",
      "wrapper": "languages/python/wrapper.py",
      "reference": "languages/python/reference.py"
    }
  },
  "sourceIds": [
    "codewise2-original"
  ],
  "checkpointIds": [
    "linked-list-03"
  ],
