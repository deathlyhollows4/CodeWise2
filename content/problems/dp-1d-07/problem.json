  "step": 4,
  "status": "published",
  "objective": "Count unordered denomination multiplicities rather than ordered sequences or the fewest coins.",
  "constraints": [
    "0 <= coins.length <= 30; denominations are distinct",
    "1 <= coins[i] <= 1000",
    "0 <= amount <= 10000",
    "Return an integer in 0..1000000006"
  ],
  "interface": "Solution.solve(coins,amount) returns the modular number of unordered combinations.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "coins": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 30,
        "unordered": true,
        "items": {
          "kind": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "amount": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": 0,
    "maximum": 1000000006
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
