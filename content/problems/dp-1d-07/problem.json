{
  "schemaVersion": 1,
  "id": "dp-1d-07",
  "version": "1.0.0",
  "slug": "unordered-reusable-coin-combinations",
  "title": "Count reusable coin combinations",
  "primaryTopic": "dp-1d",
  "skillIds": [
    "dp.unbounded-counting",
