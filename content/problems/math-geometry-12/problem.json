  "objective": "Classify an integer query point against a simple polygon while including boundary points.",
  "constraints": [
    "3 <= polygon.length <= 200",
    "Every vertex and query point has integer coordinates in [-1000000,1000000].",
    "The polygon has nonzero area, no zero-length edge, and no self-intersection.",
    "Straight consecutive edges are permitted if they do not double back."
  ],
  "interface": "Solution.solve(polygon, point) receives a typed vertex matrix and a coordinate array.",
