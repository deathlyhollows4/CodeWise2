  "step": 5,
  "status": "published",
  "objective": "Find the minimum rate when each separate job consumes a whole number of clock slots and interjob pauses cannot be shared.",
  "constraints": [
    "0 <= jobs.length <= 100000",
    "1 <= jobs[i] <= 1000000000",
    "0 <= pause <= 1000000000",
    "0 <= deadline <= 1000000000000000",
    "Each job takes at least one slot at every rate"
  ],
  "interface": "Solution.solve(jobs,pause,deadline) returns an integer rate, -1 if impossible, or 0 for an empty list.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "jobs": {
        "kind": "array",
        "unordered": true,
        "minLength": 0,
        "maxLength": 100000,
        "items": {
          "kind": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      },
      "pause": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 1000000000
      },
      "deadline": {
        "kind": "safe-integer",
        "minimum": 0,
        "maximum": 1000000000000000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -1,
    "maximum": 1000000000
  },
  "checker": {
    "kind": "exact"
  },
