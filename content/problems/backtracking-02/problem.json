  "status": "published",
  "objective": "Enumerate original-position subsets of exactly k entries having the target signed total, keeping equal-valued positions distinct.",
  "constraints": [
    "0 ≤ values.length ≤ 14.",
    "Each value lies in [-1,000,000,000,1,000,000,000].",
    "0 ≤ k ≤ values.length.",
    "-14,000,000,000 ≤ target ≤ 14,000,000,000.",
    "At most 3,432 combinations exist; preserve original positions and deterministic index ordering."
  ],
  "interface": "Solution.solve(values,k,target) receives int[],int,long / long long and returns sorted int[][].",
