  "status": "published",
  "objective": "Reverse each complete group of k native linked-list values while preserving an incomplete trailing group in its original order.",
  "constraints": [
    "0 ≤ head.length ≤ 2,000; signed values lie in [-1,000,000,1,000,000].",
    "1 ≤ k ≤ 2,001.",
    "The input is finite and acyclic; duplicate values are allowed.",
    "The returned sequence has exactly the original length, and incomplete trailing groups remain unchanged."
  ],
  "interface": "Solution.solve(head,k) receives ListNode and int and returns ListNode.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "head": {
        "kind": "array",
