          "kind": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "k": {
        "kind": "integer",
        "minimum": 1,
        "maximum": 2001
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2000,
    "items": {
