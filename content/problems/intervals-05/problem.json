  "status": "published",
  "objective": "Find the maximum signed weight simultaneously active on half-open intervals using grouped endpoint events.",
  "constraints": [
    "0 <= segments.length <= 49999",
    "Every row contains exactly [start, end, weight], with start <= end.",
    "Endpoints and weights are integers in [-1000000000, 1000000000].",
    "The total weight may be as large as 49999000000000; use a signed 64-bit result."
  ],
  "interface": "Solution.solve(segments) receives a native integer matrix of weighted half-open ranges and returns a long integer.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "segments": {
        "kind": "array",
        "maxLength": 49999,
        "unordered": true,
        "items": {
          "kind": "array",
          "minLength": 3,
          "maxLength": 3,
          "items": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": 0,
    "maximum": 49999000000000
  },
  "checker": {
    "kind": "exact"
  },
