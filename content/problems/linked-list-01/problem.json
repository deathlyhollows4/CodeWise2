{
  "schemaVersion": 1,
  "id": "linked-list-01",
  "version": "1.0.0",
  "slug": "splice-into-sorted-native-list",
  "title": "Add one value to a sorted native list",
  "primaryTopic": "linked-list",
  "skillIds": [
    "list.walk",
