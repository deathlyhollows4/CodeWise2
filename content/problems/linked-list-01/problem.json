  "step": 1,
  "status": "published",
  "objective": "Return a sorted native linked list with exactly one additional occurrence of the supplied value.",
  "constraints": [
    "0 ≤ head.length ≤ 2,000",
    "head is nondecreasing; duplicate and negative values are allowed.",
    "Node values and value lie in [-1,000,000,1,000,000]."
  ],
  "interface": "Solution.solve(head, value) receives ListNode and int, and returns ListNode.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "head": {
        "kind": "array",
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "value": {
        "kind": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2001,
    "items": {
      "kind": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    }
  },
  "checker": {
    "kind": "exact"
  },
