            "kind": "array",
            "maxLength": 2000,
            "items": {
              "kind": "integer",
              "minimum": -1000000000,
              "maximum": 1000000000
            }
          },
          "next": {
            "kind": "array",
            "maxLength": 2000,
            "items": {
              "kind": "nullable",
              "value": {
                "kind": "integer",
                "minimum": 0,
                "maximum": 1999
