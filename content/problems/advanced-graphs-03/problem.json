  "objective": "Minimize the greatest individual edge risk on an undirected route from vertex 0 to vertex n - 1, rather than its sum or hop count.",
  "constraints": [
    "0 <= n <= 500",
    "0 <= edges.length <= 5000",
    "Each row is [u,v,risk], endpoints in 0..n - 1",
    "0 <= risk <= 1000000000",
    "Return -1 or a risk in 0..1000000000"
  ],
  "interface": "Solution.solve(n,edges) receives int and int[][]; returns an int.",
  "inputSchema": {
    "kind": "object",
    "properties": {
