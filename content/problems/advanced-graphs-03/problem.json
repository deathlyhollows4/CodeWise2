        "kind": "array",
        "minLength": 0,
        "maxLength": 5000,
        "items": {
          "kind": "array",
          "minLength": 3,
          "maxLength": 3,
          "items": {
            "kind": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
