  "step": 4,
  "status": "published",
  "objective": "Remove one key while preserving the canonical successor-based tree shape, including the successor’s right child.",
  "constraints": [
    "The input has 0 to 2,000 native nodes.",
    "All node values and value lie in [-1,000,000,000,1,000,000,000].",
    "All original values are distinct. Every left subtree value is strictly less than its root and every right subtree value is strictly greater."
  ],
  "interface": "Solution.solve(root,value) returns TreeNode.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      },
      "value": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 4003,
    "trimTrailingNulls": true,
    "items": {
      "kind": "nullable",
      "value": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
