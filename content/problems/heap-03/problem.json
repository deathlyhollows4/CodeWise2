{
  "schemaVersion": 1,
  "id": "heap-03",
  "version": "1.0.0",
  "slug": "cover-all-timestamp-feeds",
  "title": "The narrowest range covering every feed",
  "primaryTopic": "heap",
  "skillIds": [
    "heap.minimum-cover-frontier",
    "heap.tracked-maximum"
  ],
  "prerequisites": [
    "heap.bounded-frontier",
    "sorted.order"
  ],
  "step": 3,
  "status": "published",
  "objective": "Find the smallest-width closed timestamp range containing an event from every independently sorted feed.",
  "constraints": [
    "1 <= feeds.length <= 20",
    "0 <= each feed length <= 1000",
    "Every timestamp is an integer in [-1000000000, 1000000000].",
    "Each feed is sorted; feeds may have different lengths."
  ],
  "interface": "Solution.solve(feeds) receives a native ragged integer matrix and returns zero or two timestamp endpoints.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "feeds": {
        "kind": "array",
        "minLength": 1,
        "maxLength": 20,
        "unordered": true,
        "deduplicate": true,
        "items": {
          "kind": "array",
          "maxLength": 1000,
          "unordered": true,
          "deduplicate": true,
          "items": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2,
    "items": {
      "kind": "integer",
      "minimum": -1000000000,
      "maximum": 1000000000
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
