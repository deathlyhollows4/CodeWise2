{
  "schemaVersion": 1,
  "id": "advanced-graphs-01",
  "version": "1.0.0",
  "slug": "least-cost-connected-network",
  "title": "Least cost of a connected network",
  "primaryTopic": "advanced-graphs",
  "skillIds": [
    "graphs.disjoint-set-state",
    "graphs.cut-safe-edge",
    "graphs.minimum-spanning-cost"
  ],
  "prerequisites": [
    "graphs.component-partition"
  ],
  "step": 1,
  "status": "published",
  "objective": "Minimize the total weight of a connected undirected spanning network, rejecting disconnected inputs.",
  "constraints": [
    "0 <= n <= 500",
    "0 <= edges.length <= 5000",
    "Each row is [u,v,cost] with 0 <= u,v < n",
    "0 <= cost <= 1000000000",
    "Return -1 or an integer in 0..499000000000"
  ],
  "interface": "Solution.solve(n,edges) receives int and int[][]; returns long / long long / int.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "n": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 500
      },
      "edges": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 5000,
        "items": {
          "kind": "array",
          "minLength": 3,
          "maxLength": 3,
          "items": {
            "kind": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "safe-integer",
    "minimum": -1,
    "maximum": 499000000000
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
