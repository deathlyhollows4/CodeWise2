    "1 <= width <= 1000000",
    "Words cannot be split or reordered",
    "Return -1 for impossible layouts; other results fit a signed 64-bit and JavaScript-safe integer"
  ],
  "interface": "Solution.solve(lengths,width) returns the minimum long/integer cost, or -1.",
  "inputSchema": {
