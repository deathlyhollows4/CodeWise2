{
  "schemaVersion": 1,
  "id": "tries-01",
  "version": "1.0.0",
  "slug": "replace-by-shortest-known-dictionary-root",
  "title": "Replace words with their shortest known root",
  "primaryTopic": "tries",
  "skillIds": [
    "arrays.traversal",
    "tries.prefix-navigation",
    "tries.shortest-terminal-root"
  ],
  "prerequisites": [
    "arrays.traversal"
  ],
  "step": 1,
  "status": "published",
  "objective": "Replace each word with its shortest dictionary prefix while preserving unmatched words and their order.",
  "constraints": [
    "0 ≤ roots.length, words.length ≤ 2,000.",
    "Roots contain 1 to 32 lowercase ASCII letters.",
    "Words contain 0 to 32 lowercase ASCII letters.",
    "Match literal prefixes; do not case-fold, match infixes, or replace by the longest root."
  ],
  "interface": "Solution.solve(roots,words) receives string[] arrays and returns string[].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "roots": {
        "kind": "array",
        "maxLength": 2000,
        "unordered": true,
        "deduplicate": true,
        "items": {
          "kind": "string",
          "minLength": 1,
          "maxLength": 32,
          "ascii": true
        }
      },
      "words": {
        "kind": "array",
        "maxLength": 2000,
        "items": {
          "kind": "string",
          "maxLength": 32,
          "ascii": true
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2000,
    "items": {
      "kind": "string",
      "maxLength": 32,
      "ascii": true
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
