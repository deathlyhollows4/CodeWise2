  "step": 4,
  "status": "published",
  "objective": "Produce any complete topological order of a directed dependency graph, or an empty impossibility result for a directed cycle.",
  "constraints": [
    "0 <= n <= 500",
    "0 <= edges.length <= 5000",
    "Every endpoint is in 0..n-1",
    "Self-loops permitted; no duplicate directed edges"
  ],
  "interface": "Solution.solve(n,edges) returns int[] / vector<int> / list[int].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "n": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 500
      },
      "edges": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 5000,
        "unordered": true,
        "items": {
          "kind": "array",
          "minLength": 2,
          "maxLength": 2,
          "items": {
            "kind": "integer",
            "minimum": 0,
            "maximum": 499
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "minLength": 0,
    "maxLength": 500,
    "items": {
      "kind": "integer",
      "minimum": 0,
      "maximum": 499
    }
  },
  "checker": {
    "kind": "custom",
    "name": "topological-order"
  },
  "harness": {
