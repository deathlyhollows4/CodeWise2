  "status": "published",
  "objective": "Add nonnegative integers stored least-significant digit first in native linked lists, propagating carries across unequal chain lengths.",
  "constraints": [
    "1 ≤ left.length and right.length ≤ 2,000.",
    "Every input/output digit lies in [0,9].",
    "Inputs are finite and acyclic; most-significant leading zero nodes are allowed.",
    "Output must be finite, have at most 2,001 nodes, and have no final most-significant zero except singleton [0]."
  ],
  "interface": "Solution.solve(left,right) receives two native ListNode heads and returns a native ListNode head.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "left": {
        "kind": "array",
        "minLength": 1,
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "right": {
        "kind": "array",
        "minLength": 1,
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "minLength": 1,
    "maxLength": 2001,
