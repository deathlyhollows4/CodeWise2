{
  "schemaVersion": 1,
  "id": "linked-list-15",
  "version": "1.0.0",
  "slug": "merge-sorted-chains-with-shared-suffix",
  "title": "Merge sorted chains without duplicating their shared tail",
  "primaryTopic": "linked-list",
  "skillIds": [
    "list.alias-aware-stable-merge",
    "list.shared-suffix-once"
  ],
  "prerequisites": [
    "list.shared-tail-identity",
    "list.link-splice",
    "sorted.order"
  ],
  "step": 4,
  "status": "published",
  "objective": "Merge the disjoint prefixes of sorted native chains stably, then append their shared suffix exactly once.",
  "constraints": [
    "0 ≤ original node count ≤ 2,000; values lie in [-1,000,000,1,000,000].",
    "Both next chains are acyclic and nondecreasing; every node is reachable from at least one head.",
    "The input may have a shared suffix; equal-valued distinct nodes remain distinct.",
    "Output contains the original union once, preserves values, and is finite."
  ],
  "interface": "Solution.solve(data) receives IdentityList and returns ListNodeIdentitySequence.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "data": {
        "kind": "object",
        "properties": {
          "values": {
            "kind": "array",
            "maxLength": 2000,
            "items": {
              "kind": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "next": {
            "kind": "array",
            "maxLength": 2000,
            "items": {
              "kind": "nullable",
              "value": {
                "kind": "integer",
                "minimum": 0,
                "maximum": 1999
              }
            }
          },
          "heads": {
            "kind": "array",
            "minLength": 2,
            "maxLength": 2,
            "items": {
              "kind": "nullable",
              "value": {
                "kind": "integer",
                "minimum": 0,
                "maximum": 1999
              }
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2000,
