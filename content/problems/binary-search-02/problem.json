  "status": "published",
  "objective": "Find the first position satisfying a threshold, including duplicates and a missing boundary.",
  "constraints": [
    "0 ≤ values.length ≤ 100000",
    "Values and target are between -1000000000 and 1000000000",
    "values is sorted in nondecreasing order"
  ],
  "interface": "Solution.solve(values, target) returns an integer boundary position.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "values": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 100000,
        "items": {
          "kind": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      },
      "target": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -1000000000,
    "maximum": 1000000000
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
