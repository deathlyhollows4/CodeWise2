  "objective": "Compute the total area covered by possibly overlapping axis-aligned integer rectangles without double counting.",
  "constraints": [
    "0 <= rectangles.length <= 100",
    "Every coordinate is an integer in [-1000000,1000000].",
    "Each row satisfies x1 <= x2 and y1 <= y2.",
    "The result can be as large as 4000000000000 and requires a long integer."
  ],
  "interface": "Solution.solve(rectangles) receives a typed matrix of four-coordinate rectangles.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "rectangles": {
        "kind": "array",
        "maxLength": 100,
        "unordered": true,
        "deduplicate": true,
        "items": {
          "kind": "array",
          "minLength": 4,
          "maxLength": 4,
          "items": {
            "kind": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        }
      }
    }
  },
