{
  "schemaVersion": 1,
  "id": "intervals-01",
  "version": "1.0.0",
  "slug": "closed-coverage-union",
  "title": "Merge closed coverage ranges",
  "primaryTopic": "intervals",
  "skillIds": [
    "intervals.sorted-union",
    "intervals.endpoint-contact"
  ],
  "prerequisites": [
    "arrays.traversal"
  ],
  "step": 1,
  "status": "published",
  "objective": "Represent the union of closed real-line intervals as sorted disjoint coverage ranges.",
  "constraints": [
    "0 <= intervals.length <= 10000",
    "Every row has exactly two integer endpoints in [-1000000000, 1000000000].",
    "Each start is at most its end."
  ],
  "interface": "Solution.solve(intervals) receives a native integer matrix and returns a native matrix of merged endpoint pairs.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "intervals": {
        "kind": "array",
        "maxLength": 10000,
        "unordered": true,
        "deduplicate": true,
        "items": {
          "kind": "array",
          "minLength": 2,
          "maxLength": 2,
          "items": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 10000,
    "items": {
      "kind": "array",
      "minLength": 2,
      "maxLength": 2,
      "items": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
    "cpp": {
      "starter": "languages/cpp/starter.cpp",
      "wrapper": "languages/cpp/wrapper.cpp",
