  ],
  "rationale": "Sorting puts the next possible overlap beside the current range. Endpoint contact counts as coverage and extends that range.",
  "commonMistakes": [
    "do-not-merge-touching",
    "drop-point-ranges",
    "overwrite-containing-end"
  ],
