{
  "schemaVersion": 1,
  "id": "tries-02",
  "version": "1.0.0",
  "slug": "fixed-length-wildcard-dictionary-match",
  "title": "Match a dictionary word with one-letter wildcards",
  "primaryTopic": "tries",
  "skillIds": [
    "arrays.traversal",
    "tries.prefix-navigation",
    "tries.wildcard-branch-search",
    "tries.exact-terminal-match"
  ],
  "prerequisites": [
    "arrays.traversal",
    "tries.prefix-navigation"
  ],
  "step": 1,
  "status": "published",
  "objective": "Decide whether one whole dictionary word matches a literal-and-one-letter-wildcard pattern.",
  "constraints": [
    "0 ≤ words.length ≤ 2,000.",
    "Dictionary words contain 1 to 32 lowercase ASCII letters.",
    "The pattern contains 0 to 32 lowercase ASCII letters or question marks.",
    "Each ? consumes exactly one letter; no other pattern operators exist."
  ],
  "interface": "Solution.solve(words,pattern) receives string[] and string and returns boolean.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "words": {
        "kind": "array",
        "maxLength": 2000,
        "unordered": true,
        "deduplicate": true,
        "items": {
          "kind": "string",
          "minLength": 1,
          "maxLength": 32,
          "ascii": true
        }
      },
      "pattern": {
        "kind": "string",
        "maxLength": 32,
        "ascii": true
      }
    }
  },
  "outputSchema": {
    "kind": "boolean"
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
