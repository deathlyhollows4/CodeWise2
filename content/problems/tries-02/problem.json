  "rationale": "A wildcard branches to existing child letters; matching a prefix without a terminal node or accepting a different word length is incorrect.",
  "commonMistakes": [
    "accept-nonterminal-prefix",
    "treat-question-mark-as-zero-or-many"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
