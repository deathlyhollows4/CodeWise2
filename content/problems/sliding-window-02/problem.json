          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "k": {
        "kind": "integer",
        "minimum": 1,
        "maximum": 2000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": 1,
    "maximum": 2000
