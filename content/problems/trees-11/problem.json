{
  "schemaVersion": 1,
  "id": "trees-11",
  "version": "1.0.0",
  "slug": "signed-root-to-leaf-target-total",
  "title": "Find a complete root-to-leaf target total",
  "primaryTopic": "trees",
  "skillIds": [
    "trees.branch-local-sum",
    "trees.leaf-only-target"
  ],
  "prerequisites": [
    "trees.child-links",
    "trees.leaf-predicate",
    "numbers.signed-accumulation"
  ],
  "step": 3,
  "status": "published",
  "objective": "Test whether one complete root-to-leaf route has the supplied signed total, without accepting internal prefixes or pruning negative values incorrectly.",
  "constraints": [
    "0 ≤ native node count ≤ 2,000.",
    "Node values lie in [-1,000,000,000,1,000,000,000].",
    "The input is a finite binary tree; sparse children, duplicate values and deep chains are allowed.",
    "Do not modify original node values or links.",
    "-2,000,000,000,000 ≤ target ≤ 2,000,000,000,000."
  ],
  "interface": "Solution.solve(root,target) receives TreeNode and long / long long and returns boolean.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      },
      "target": {
        "kind": "integer",
        "minimum": -2000000000000,
        "maximum": 2000000000000
      }
    }
  },
  "outputSchema": {
    "kind": "boolean"
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
    "cpp": {
      "starter": "languages/cpp/starter.cpp",
      "wrapper": "languages/cpp/wrapper.cpp",
      "reference": "languages/cpp/reference.cpp"
    },
    "python": {
      "starter": "languages/python/starter.py",
      "wrapper": "languages/python/wrapper.py",
      "reference": "languages/python/reference.py"
    }
  },
