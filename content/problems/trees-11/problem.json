  "rationale": "Each branch needs its own accumulated sum, and a matching internal node is not a completed route.",
  "commonMistakes": [
    "accept-internal-prefix",
    "discard-sum-above-target"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
