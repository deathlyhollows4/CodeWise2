  "nextIds": [],
  "rationale": "The cursors can move by a whole shared run length rather than one character at a time.",
  "commonMistakes": [
    "compare-only-raw-runs",
    "compare-only-letter-order"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
    "outputBytes": 4194304,
