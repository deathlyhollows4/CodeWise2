{
  "schemaVersion": 1,
  "id": "two-pointers-10",
  "version": "1.0.0",
  "slug": "compare-compressed-letter-runs",
  "title": "Compare compressed letter runs",
  "primaryTopic": "two-pointers",
  "skillIds": [
    "pointers.residual-run-lengths"
  ],
  "prerequisites": [
    "pointers.merge-cursors"
  ],
  "step": 5,
  "status": "published",
  "objective": "Compare two compressed sequences by consuming the smaller remaining run without expanding large counts.",
  "constraints": [
    "0 ≤ each symbols string length ≤ 100",
    "symbols contain lowercase ASCII letters a..z.",
    "Each counts array length equals its symbols string length.",
    "1 ≤ each count ≤ 1,000,000,000."
  ],
  "interface": "Solution.solve(symbolsA,countsA,symbolsB,countsB) returns a boolean.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "symbolsA": {
        "kind": "string",
        "ascii": true,
        "maxLength": 100
      },
      "countsA": {
        "kind": "array",
        "maxLength": 100,
        "items": {
          "kind": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      },
      "symbolsB": {
        "kind": "string",
        "ascii": true,
        "maxLength": 100
      },
      "countsB": {
        "kind": "array",
        "maxLength": 100,
        "items": {
          "kind": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    }
  },
  "outputSchema": {
    "kind": "boolean"
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
