  },
  "semanticConstraints": [
    {
      "kind": "alphabet",
      "field": "symbolsA",
      "alphabet": "lowercase"
    },
    {
      "kind": "alphabet",
      "field": "symbolsB",
      "alphabet": "lowercase"
    },
    {
      "kind": "lengths-equal",
      "left": "symbolsA",
      "right": "countsA"
    },
    {
      "kind": "lengths-equal",
      "left": "symbolsB",
      "right": "countsB"
    }
  ]
