  "status": "published",
  "objective": "Compute canonical skyline change points from half-open building spans using an expiring maximum frontier.",
  "constraints": [
    "0 <= buildings.length <= 30000",
    "Each row has three integers, with -1000000000 <= left < right <= 1000000000.",
    "1 <= height <= 1000000000",
    "At most 60000 change points can occur."
  ],
  "interface": "Solution.solve(buildings) receives a native matrix of building triples and returns a native matrix of skyline change points.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "buildings": {
        "kind": "array",
        "maxLength": 30000,
        "unordered": true,
        "deduplicate": true,
        "items": {
          "kind": "array",
          "minLength": 3,
          "maxLength": 3,
          "items": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 60000,
    "items": {
      "kind": "array",
      "minLength": 2,
      "maxLength": 2,
