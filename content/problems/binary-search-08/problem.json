{
  "schemaVersion": 1,
  "id": "binary-search-08",
  "version": "1.0.0",
  "slug": "any-strict-local-peak",
  "title": "Find any strict local peak",
  "primaryTopic": "binary-search",
  "skillIds": [
    "binary-search.halving",
    "binary-search.slope-invariant"
  ],
  "prerequisites": [
    "binary-search.halving"
  ],
  "step": 4,
  "status": "published",
  "objective": "Return any neighbor-local peak by maintaining an interval guaranteed to contain a peak.",
  "constraints": [
    "1 <= values.length <=100000",
    "-1000000000 <= values[i] <=1000000000",
    "values[i] != values[i+1] for every adjacent pair"
  ],
  "interface": "Solution.solve(values) returns any valid zero-based peak index.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "values": {
        "kind": "array",
        "minLength": 1,
        "maxLength": 100000,
        "items": {
          "kind": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": 0,
    "maximum": 99999
  },
  "checker": {
    "kind": "custom",
    "name": "strict-local-peak"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
