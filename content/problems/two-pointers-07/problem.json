{
  "schemaVersion": 1,
  "id": "two-pointers-07",
  "version": "1.0.0",
  "slug": "unique-value-triples",
  "title": "Unique triples for a target",
  "primaryTopic": "two-pointers",
  "skillIds": [
    "pointers.anchored-pair-search",
    "sorted.duplicate-skips"
  ],
  "prerequisites": [
    "pointers.target-sum",
    "sorted.order"
  ],
  "step": 4,
  "status": "published",
  "objective": "Anchor one value and search opposing pairs while reporting each value triple once.",
  "constraints": [
    "0 ≤ values.length ≤ 80",
    "Each value is in [-1,000,000,1,000,000].",
    "target is in [-3,000,000,3,000,000]."
  ],
  "interface": "Solution.solve(values,target) returns a nested integer array.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "values": {
        "kind": "array",
        "maxLength": 80,
        "items": {
          "kind": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "unordered": true
      },
      "target": {
        "kind": "integer",
        "minimum": -3000000,
        "maximum": 3000000
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 4000,
    "items": {
      "kind": "array",
      "maxLength": 3,
      "items": {
        "kind": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "minLength": 3
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
