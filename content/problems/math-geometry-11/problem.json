  "objective": "Detect proper crossings, shared endpoints, collinear overlap and degenerate intersections between closed integer segments.",
  "constraints": [
    "first and second each contain exactly two [x,y] endpoint pairs.",
    "Every coordinate is an integer in [-1000000,1000000].",
    "Endpoint order does not matter; zero-length segments are allowed."
  ],
  "interface": "Solution.solve(first, second) receives two typed endpoint matrices.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "first": {
        "kind": "array",
        "minLength": 2,
        "maxLength": 2,
        "unordered": true,
        "items": {
          "kind": "array",
          "minLength": 2,
          "maxLength": 2,
          "items": {
            "kind": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        }
      },
      "second": {
        "kind": "array",
        "minLength": 2,
        "maxLength": 2,
        "unordered": true,
        "items": {
          "kind": "array",
          "minLength": 2,
          "maxLength": 2,
          "items": {
            "kind": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        }
      }
    }
  },
  "outputSchema": {
