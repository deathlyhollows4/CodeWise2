{
  "schemaVersion": 1,
  "id": "sliding-window-01",
  "version": "1.0.0",
  "slug": "best-fixed-batch-total",
  "title": "Best fixed batch total",
  "primaryTopic": "sliding-window",
  "skillIds": [
    "windows.fixed-boundaries",
    "windows.rolling-sum"
  ],
  "prerequisites": [
    "arrays.traversal"
  ],
  "step": 1,
  "status": "published",
  "objective": "Update a fixed-length total by removing the old left value and adding the new right value.",
  "constraints": [
    "1 ≤ values.length ≤ 2,000",
    "1 ≤ k ≤ values.length",
    "Every value is in [-1,000,000, 1,000,000].",
    "Return the mathematical total using a 64-bit integer type where needed."
  ],
  "interface": "Solution.solve(values,k) returns a signed integer total.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "values": {
        "kind": "array",
        "minLength": 1,
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "k": {
        "kind": "integer",
        "minimum": 1,
        "maximum": 2000
      }
    }
  },
  "outputSchema": {
    "kind": "safe-integer"
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
    "cpp": {
      "starter": "languages/cpp/starter.cpp",
      "wrapper": "languages/cpp/wrapper.cpp",
      "reference": "languages/cpp/reference.cpp"
    },
    "python": {
      "starter": "languages/python/starter.py",
      "wrapper": "languages/python/wrapper.py",
      "reference": "languages/python/reference.py"
    }
  },
  "sourceIds": [
