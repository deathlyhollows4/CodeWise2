    "arrays-hashing-01"
  ],
  "nextIds": [
    "sliding-window-03"
  ],
  "rationale": "Reuse one total when the window moves, instead of summing every batch from scratch.",
  "commonMistakes": [
    "initialize-answer-zero",
    "omit-final-window"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
    "outputBytes": 4194304,
    "fileKb": 4096,
    "inputBytes": 8388608
  },
  "semanticConstraints": [
    {
      "kind": "length-relative",
