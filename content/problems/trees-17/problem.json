  "step": 4,
  "status": "published",
  "objective": "Return the deepest original node that is an ancestor of both native target objects, allowing repeated values and identical targets.",
  "constraints": [
    "The tree contains 1 to 2,000 native nodes.",
    "Values lie in [-1,000,000,000,1,000,000,000] and may repeat.",
    "Both targets are original non-null nodes in the same tree; the same node may be supplied twice.",
    "The tree is finite and original values/links remain unchanged."
  ],
  "interface": "Solution.solve(data) receives IdentityTree and returns an original TreeNode.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "data": {
        "kind": "object",
        "properties": {
          "values": {
            "kind": "array",
            "maxLength": 4001,
            "trimTrailingNulls": true,
            "items": {
              "kind": "nullable",
              "value": {
                "kind": "integer",
                "minimum": -1000000000,
                "maximum": 1000000000
              }
            },
            "minLength": 1
          },
          "targetIndices": {
            "kind": "array",
            "unordered": true,
            "minLength": 2,
            "maxLength": 2,
            "items": {
              "kind": "integer",
              "minimum": 0,
              "maximum": 4000
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": 0,
    "maximum": 4000
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
