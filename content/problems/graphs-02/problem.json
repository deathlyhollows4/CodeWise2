  "step": 2,
  "status": "published",
  "objective": "Count the minimum-hop directed edge routes from vertex zero to every vertex, adding only equal-next-layer contributions.",
  "constraints": [
    "0 <= n <= 500",
    "0 <= edges.length <= 5000",
    "Every edge endpoint is in 0..n-1",
    "Parallel directed edges and self-loops are allowed",
    "Every output count lies in 0..1000000006"
  ],
  "interface": "Solution.solve(n,edges) receives int and int[][]; returns int[] / vector<int> / list[int].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "n": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 500
      },
      "edges": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 5000,
        "unordered": true,
        "items": {
          "kind": "array",
          "minLength": 2,
          "maxLength": 2,
          "items": {
            "kind": "integer",
            "minimum": 0,
            "maximum": 499
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "minLength": 0,
    "maxLength": 500,
    "items": {
      "kind": "integer",
      "minimum": 0,
      "maximum": 1000000006
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
