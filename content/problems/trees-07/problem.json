{
  "schemaVersion": 1,
  "id": "trees-07",
  "version": "1.0.0",
  "slug": "native-breadth-first-level-values",
  "title": "Keep each breadth-first level together",
  "primaryTopic": "trees",
  "skillIds": [
    "trees.level-grouping",
