  "step": 2,
  "status": "published",
  "objective": "Return every node value grouped by depth, preserving left-to-right order and capturing each level before adding its children.",
  "constraints": [
    "0 ≤ native node count ≤ 2,000.",
    "Node values lie in [-1,000,000,000,1,000,000,000].",
    "The input is a finite binary tree; sparse children, duplicate values and deep chains are allowed.",
    "Do not modify original node values or links."
  ],
  "interface": "Solution.solve(root) returns int[][] / vector<vector<int>> / Python list[list[int]].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2000,
    "items": {
      "kind": "array",
      "maxLength": 2000,
      "items": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
