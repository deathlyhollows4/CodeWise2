  "step": 1,
  "status": "published",
  "objective": "Discard an entire failed prefix when selecting the smallest start that can complete a circular route.",
  "constraints": [
    "0 <= gas.length = cost.length <= 90000",
    "Every fuel amount and cost is in 0..1000000000",
    "Running totals may reach 90000000000000; use signed 64-bit accumulation"
  ],
  "interface": "Solution.solve(gas, cost) returns the smallest feasible start index or -1.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "gas": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 90000,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "cost": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 90000,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -1,
    "maximum": 89999
  },
  "checker": {
    "kind": "exact"
  },
