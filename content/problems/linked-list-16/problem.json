  "status": "published",
  "objective": "Remove an entire repeated-value run rather than keeping one representative, preserving the identities of uniquely occurring nodes.",
  "constraints": [
    "0 ≤ node count ≤ 2,000; values lie in [-1,000,000,1,000,000].",
    "The finite input is nondecreasing.",
    "Retain exactly the nodes whose values occur once, with original values/identities unchanged."
  ],
  "interface": "Solution.solve(head) returns a native ListNode; ListNodeIdentitySequence checks surviving original nodes.",
  "inputSchema": {
    "kind": "object",
    "properties": {
