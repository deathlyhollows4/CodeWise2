{
  "schemaVersion": 1,
  "id": "trees-04",
  "version": "1.0.0",
  "slug": "native-preorder-visit-values",
  "title": "Visit root, then left, then right",
  "primaryTopic": "trees",
  "skillIds": [
    "trees.preorder-order",
    "trees.explicit-stack-order"
  ],
  "prerequisites": [
    "trees.child-links"
  ],
  "step": 2,
  "status": "published",
  "objective": "Produce preorder values from native child links while preserving duplicate visits and left-before-right ordering.",
  "constraints": [
    "0 ≤ native node count ≤ 2,000.",
    "Node values lie in [-1,000,000,000,1,000,000,000].",
    "The input is a finite binary tree; sparse children, duplicate values and deep chains are allowed.",
    "Do not modify original node values or links."
  ],
  "interface": "Solution.solve(root) receives TreeNode and returns int[] / vector<int> / Python list[int].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2000,
    "items": {
      "kind": "integer",
      "minimum": -1000000000,
      "maximum": 1000000000
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
    "cpp": {
      "starter": "languages/cpp/starter.cpp",
      "wrapper": "languages/cpp/wrapper.cpp",
