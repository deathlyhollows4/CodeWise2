  "step": 3,
  "status": "published",
  "objective": "Perform one exact arithmetic operation on two rational numbers and return their canonical reduced representation.",
  "constraints": [
    "-1000000 <= aNum,bNum <= 1000000",
    "1 <= aDen,bDen <= 1000000",
    "operation is +, -, *, or /; when it is /, bNum is nonzero.",
    "Intermediate products and sums fit signed 64 bit integers."
  ],
  "interface": "Solution.solve(aNum, aDen, bNum, bDen, operation) receives four long integers and a string, and returns a long array of length two.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "aNum": {
        "kind": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "aDen": {
        "kind": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "bNum": {
        "kind": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "bDen": {
        "kind": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "operation": {
        "kind": "enum",
        "values": [
          "+",
          "-",
          "*",
          "/"
        ]
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "minLength": 2,
    "maxLength": 2,
    "items": {
      "kind": "safe-integer"
    }
  },
  "checker": {
