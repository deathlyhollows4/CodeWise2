  "slug": "exact-rational-operation",
  "title": "Normalize an exact rational operation",
  "primaryTopic": "math-geometry",
  "skillIds": [
    "numbers.rational-normalization",
    "numbers.sign-canonicalization"
  ],
  "prerequisites": [
    "numbers.divisibility",
