  "rationale": "Equal values never imply shared nodes. Aligning native chain lengths identifies the first common object in the shared suffix.",
  "commonMistakes": [
    "equal-value-as-sharing",
    "last-shared-node"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
    "outputBytes": 4194304,
    "fileKb": 4096,
    "inputBytes": 8388608
  },
  "semanticConstraints": [
    {
      "kind": "node-table",
      "field": "data",
      "links": [
        "next"
      ],
      "heads": "heads",
      "requireReachable": true,
      "acyclicLinks": [
        "next"
      ]
    }
