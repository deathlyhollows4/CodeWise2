{
  "schemaVersion": 1,
  "id": "linked-list-05",
  "version": "1.0.0",
  "slug": "first-shared-original-list-node",
  "title": "Find the shared original node",
  "primaryTopic": "linked-list",
  "skillIds": [
    "list.shared-tail-identity",
    "list.align-chain-lengths"
  ],
  "prerequisites": [
    "list.walk",
    "list.original-identity"
  ],
  "step": 3,
  "status": "published",
  "objective": "Return the first shared original node of two acyclic chains, distinguishing equal values from shared pointer identity.",
  "constraints": [
    "0 ≤ data.values.length ≤ 2,000; values lie in [-1,000,000,1,000,000].",
    "next has one nullable bounded index per node; heads contains exactly two nullable bounded indexes.",
    "Both next chains are finite and acyclic; every original node is reachable from at least one head.",
    "Chains may be identical, disjoint, share a suffix, or have a null head."
  ],
  "interface": "Solution.solve(data) receives IdentityList and returns an original ListNode or null.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "data": {
        "kind": "object",
        "properties": {
          "values": {
            "kind": "array",
            "maxLength": 2000,
            "items": {
              "kind": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "next": {
            "kind": "array",
            "maxLength": 2000,
            "items": {
              "kind": "nullable",
              "value": {
                "kind": "integer",
                "minimum": 0,
                "maximum": 1999
              }
            }
          },
          "heads": {
            "kind": "array",
            "minLength": 2,
            "maxLength": 2,
            "items": {
              "kind": "nullable",
              "value": {
                "kind": "integer",
                "minimum": 0,
                "maximum": 1999
              }
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "nullable",
    "value": {
      "kind": "integer",
      "minimum": 0,
      "maximum": 1999
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
    "cpp": {
      "starter": "languages/cpp/starter.cpp",
      "wrapper": "languages/cpp/wrapper.cpp",
      "reference": "languages/cpp/reference.cpp"
    },
    "python": {
      "starter": "languages/python/starter.py",
      "wrapper": "languages/python/wrapper.py",
