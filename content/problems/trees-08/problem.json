  "step": 2,
  "status": "published",
  "objective": "Exchange left and right structure at every node, preserving the corresponding node values and sparse topology.",
  "constraints": [
    "0 ≤ native node count ≤ 2,000.",
    "Node values lie in [-1,000,000,000,1,000,000,000].",
    "The input is a finite binary tree; sparse children, duplicate values and deep chains are allowed.",
    "You may relink input child pointers or return a new native tree; the result must have mirrored topology and the corresponding original values. Original node identity is not required."
  ],
  "interface": "Solution.solve(root) receives TreeNode and returns TreeNode; the wrapper displays compact breadth-first result values.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 4001,
    "trimTrailingNulls": true,
    "items": {
      "kind": "nullable",
      "value": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
