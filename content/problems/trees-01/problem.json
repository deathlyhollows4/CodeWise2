{
  "schemaVersion": 1,
  "id": "trees-01",
  "version": "1.0.0",
  "slug": "count-native-binary-tree-nodes",
  "title": "Count the nodes in the tree",
  "primaryTopic": "trees",
  "skillIds": [
    "trees.child-links",
    "trees.node-visitation"
  ],
  "prerequisites": [
    "arrays.traversal"
  ],
  "step": 1,
  "status": "published",
  "objective": "Visit native child links and count each existing binary-tree node once.",
  "constraints": [
    "0 ≤ native node count ≤ 2,000.",
    "Node values lie in [-1,000,000,000,1,000,000,000].",
    "The input is a finite binary tree; sparse children, duplicate values and deep chains are allowed.",
    "Do not modify original node values or links."
  ],
  "interface": "Solution.solve(root) receives TreeNode and returns int.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": 0,
    "maximum": 2000
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
    "cpp": {
      "starter": "languages/cpp/starter.cpp",
      "wrapper": "languages/cpp/wrapper.cpp",
      "reference": "languages/cpp/reference.cpp"
    },
    "python": {
      "starter": "languages/python/starter.py",
      "wrapper": "languages/python/wrapper.py",
      "reference": "languages/python/reference.py"
    }
  },
  "sourceIds": [
    "codewise2-original"
  ],
  "checkpointIds": [
    "trees-02"
  ],
  "remedialIds": [
    "arrays-hashing-01"
  ],
  "nextIds": [
    "trees-03"
  ],
  "rationale": "Missing child positions are not nodes, and duplicate node values do not merge identities.",
  "commonMistakes": [
    "count-null-slots",
    "ignore-right-subtrees"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
    "outputBytes": 4194304,
    "fileKb": 4096,
    "inputBytes": 8388608
  },
  "semanticConstraints": [
    {
      "kind": "tree-level",
      "field": "root",
      "maxNodes": 2000
    }
  ]
}
