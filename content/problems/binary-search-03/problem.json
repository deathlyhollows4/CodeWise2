  "objective": "Combine lower and upper boundaries to count sorted readings in a closed value interval.",
  "constraints": [
    "0 ≤ values.length ≤ 100000",
    "Values, lo and hi are in [-1000000000,1000000000]",
    "lo ≤ hi; values is sorted in nondecreasing order"
  ],
  "interface": "Solution.solve(values, lo, hi) returns an integer count.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "values": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 100000,
        "items": {
          "kind": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      },
      "lo": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      },
      "hi": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -1000000000,
    "maximum": 1000000000
  },
