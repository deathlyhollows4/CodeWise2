  "rationale": "Inorder traversal visits strict-BST keys in increasing order, but the returned object must be the original node rather than an equal-valued replacement.",
  "commonMistakes": [
    "treat-k-as-zero-based",
    "return-key-instead-of-original-node-id"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
