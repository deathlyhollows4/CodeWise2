  ],
  "interface": "Solution.solve(tokens) returns a 64-bit integer result.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "tokens": {
        "kind": "array",
        "minLength": 1,
        "maxLength": 31,
        "items": {
          "kind": "string",
          "ascii": true,
          "minLength": 1,
          "maxLength": 5
        }
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -1000000000,
    "maximum": 1000000000
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
