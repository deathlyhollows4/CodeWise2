  "step": 5,
  "status": "published",
  "objective": "Enumerate nonattacking placements with blocked squares and immutable row-specific queen constraints.",
  "constraints": [
    "0 ≤ n ≤ 8.",
    "allowed is an n×n matrix with entries 0 or 1.",
    "fixed has length n and each entry is −1 or a column in [0,n−1].",
    "Queens must occupy available squares and obey every nonnegative fixed entry.",
    "Columns and both diagonals must be distinct; all answers use one queen per row.",
    "At most 92 arrangements exist on any supported unrestricted board."
  ],
  "interface": "Solution.solve(allowed:int[][],fixed:int[]) returns ordered int[][] column arrangements.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "allowed": {
        "kind": "array",
        "maxLength": 8,
        "rectangular": true,
        "items": {
          "kind": "array",
          "maxLength": 8,
          "items": {
            "kind": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "fixed": {
        "kind": "array",
        "maxLength": 8,
        "items": {
          "kind": "integer",
          "minimum": -1,
          "maximum": 7
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 92,
