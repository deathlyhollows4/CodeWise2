  "rationale": "A local permission does not guarantee global feasibility: multiple positions may compete for the same original item. This introduces constrained permutations and all-different state, distinct from signed subset enumeration.",
  "commonMistakes": [
    "reuse-permitted-items",
    "transpose-position-item-permissions",
    "reverse-enumeration-order"
  ],
