{
  "schemaVersion": 1,
  "id": "backtracking-04",
  "version": "1.0.0",
  "slug": "enumerate-position-permitted-item-permutations",
  "title": "Arrange items with position-specific permissions",
  "primaryTopic": "backtracking",
  "skillIds": [
    "backtracking.branch-restoration",
    "backtracking.used-item-state",
    "backtracking.position-constraints"
  ],
  "prerequisites": [
    "backtracking.branch-restoration"
  ],
  "step": 2,
  "status": "published",
  "objective": "Enumerate complete bijections satisfying position-specific permissions, restoring both the path and used-item state between branches.",
  "constraints": [
    "0 ≤ n ≤ 7.",
    "allowed has exactly n rows and n columns; each entry is 0 or 1.",
    "Item IDs are distinct original positions from 0 through n−1.",
    "At most 7! = 5,040 permutations exist.",
    "Return rows in lexicographic order; the input permissions must remain unchanged."
  ],
  "interface": "Solution.solve(allowed: int[][]) returns lexicographically ordered int[][].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "allowed": {
        "kind": "array",
        "maxLength": 7,
        "rectangular": true,
        "items": {
          "kind": "array",
          "maxLength": 7,
          "items": {
            "kind": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 5040,
    "items": {
      "kind": "array",
      "maxLength": 7,
      "items": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 6
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
