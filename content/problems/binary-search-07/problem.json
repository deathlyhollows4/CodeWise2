{
  "schemaVersion": 1,
  "id": "binary-search-07",
  "version": "1.0.0",
  "slug": "target-after-a-rotation",
  "title": "Find a target after rotation",
  "primaryTopic": "binary-search",
  "skillIds": [
    "binary-search.halving",
    "binary-search.rotated-order",
    "binary-search.sorted-half-selection"
