    "binary-search.halving",
    "binary-search.rotated-order"
  ],
  "step": 4,
  "status": "published",
  "objective": "Find an exact target by identifying which half of a rotated distinct sequence stays sorted.",
  "constraints": [
    "0 <= values.length <=100000",
    "-1000000000 <= values[i],target <=1000000000",
    "values is a rotation of a strictly increasing sequence; no duplicates"
  ],
  "interface": "Solution.solve(values,target) returns a zero-based integer index or -1.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "values": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 100000,
        "items": {
          "kind": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      },
      "target": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -1,
    "maximum": 99999
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
