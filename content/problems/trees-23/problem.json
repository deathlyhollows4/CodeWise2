    "numbers.signed-accumulation"
  ],
  "step": 3,
  "status": "published",
  "objective": "Sum every native key in the inclusive bounds, pruning branches ruled out by strict subtree ordering.",
  "constraints": [
    "The input has 0 to 2,000 native nodes.",
    "All node values lie in [-1,000,000,000,1,000,000,000].",
    "All original values are distinct. Every left subtree value is strictly less than its root and every right subtree value is strictly greater.",
    "-1,000,000,000 ≤ lo ≤ hi ≤ 1,000,000,000.",
    "A total can exceed 32-bit range; return long / long long."
  ],
  "interface": "Solution.solve(root,lo,hi) returns long / long long.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      },
      "lo": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      },
      "hi": {
        "kind": "integer",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -2000000000000,
    "maximum": 2000000000000
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
