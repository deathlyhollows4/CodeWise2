  "status": "published",
  "objective": "Recognize nodes with neither child and sum only their signed values using a wide accumulator.",
  "constraints": [
    "0 ≤ native node count ≤ 2,000.",
    "Node values lie in [-1,000,000,000,1,000,000,000].",
    "The input is a finite binary tree; sparse children, duplicate values and deep chains are allowed.",
    "Do not modify original node values or links."
  ],
  "interface": "Solution.solve(root) receives TreeNode and returns long / long long / Python int.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -2000000000000,
    "maximum": 2000000000000
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
