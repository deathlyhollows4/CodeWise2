  "objective": "Unlink every matching node, including repeated matches at the head, while preserving the order of remaining values.",
  "constraints": [
    "0 ≤ head.length ≤ 2,000",
    "Values lie in [-1,000,000,1,000,000].",
    "The input is finite and acyclic; duplicate values are allowed."
  ],
  "interface": "Solution.solve(head, value) receives ListNode and int, and returns ListNode.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "head": {
        "kind": "array",
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "value": {
        "kind": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2000,
    "items": {
      "kind": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    }
  },
