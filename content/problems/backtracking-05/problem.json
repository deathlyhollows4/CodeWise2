  ],
  "step": 3,
  "status": "published",
  "objective": "Enumerate bounded multiplicity vectors for a wide target without inventing stock or duplicate orderings.",
  "constraints": [
    "0 ≤ values.length = stock.length ≤ 7.",
    "Denominations are strictly increasing integers in [1,1,000,000,000].",
    "Every stock count lies in [0,3].",
    "−21,000,000,000 ≤ target ≤ 21,000,000,000.",
    "At most 4^7 = 16,384 quantity vectors can be explored; answer rows must preserve all denomination positions."
  ],
  "interface": "Solution.solve(values:int[],stock:int[],target:long / long long) returns sorted int[][].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "values": {
        "kind": "array",
        "maxLength": 7,
        "items": {
          "kind": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      },
      "stock": {
        "kind": "array",
        "maxLength": 7,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "target": {
        "kind": "integer",
        "minimum": -21000000000,
        "maximum": 21000000000
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 16384,
    "items": {
      "kind": "array",
      "maxLength": 7,
      "items": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 3
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
