  "step": 3,
  "status": "published",
  "objective": "Classify every position in an alternating-turn directed game as a forced win, forced loss or optimal draw, including cycles and terminal targets.",
  "constraints": [
    "0 <= n <= 150",
    "moves is an n by n matrix of 0/1 values",
    "targets has n entries, each 0 or 1",
    "Target vertices and non-target sinks are terminal losing positions",
    "Return exactly n strings WIN, LOSE or DRAW"
  ],
  "interface": "Solution.solve(moves,targets) receives int[][] and int[]; returns String[] / vector<string> / list[str].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "moves": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 150,
        "rectangular": true,
        "items": {
          "kind": "array",
          "minLength": 0,
          "maxLength": 150,
          "items": {
            "kind": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "targets": {
        "kind": "array",
        "minLength": 0,
        "maxLength": 150,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "minLength": 0,
    "maxLength": 150,
    "items": {
      "kind": "enum",
      "values": [
        "WIN",
        "LOSE",
        "DRAW"
      ]
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
