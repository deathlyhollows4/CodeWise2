{
  "schemaVersion": 1,
  "id": "linked-list-17",
  "version": "1.0.0",
  "slug": "original-node-cut-and-insert-history",
  "title": "Move identified original nodes through a history",
  "primaryTopic": "linked-list",
  "skillIds": [
    "list.stable-addressed-node-moves",
    "list.predecessor-maintenance"
  ],
  "prerequisites": [
    "list.walk",
    "list.link-splice",
    "list.original-identity"
  ],
  "step": 4,
  "status": "published",
  "objective": "Apply cut-and-insert operations addressed by immutable original node indexes, rather than changing current positions or values.",
  "constraints": [
    "0 ≤ node count and operation count ≤ 2,000.",
    "Node values lie in [-1,000,000,1,000,000]; duplicates do not merge identities.",
    "cutIds and afterIds have equal lengths.",
    "Every cut identifier lies in [0,n-1]; every after identifier lies in [-1,n-1]."
  ],
  "interface": "Solution.solve(head,cutIds,afterIds) returns ListNodeIdentitySequence.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "head": {
        "kind": "array",
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "cutIds": {
        "kind": "array",
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 1999
        }
      },
      "afterIds": {
        "kind": "array",
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": -1,
          "maximum": 1999
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 2000,
    "items": {
      "kind": "integer",
      "minimum": 0,
      "maximum": 1999
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
  "languageFiles": {
    "java": {
      "starter": "languages/java/starter.java",
      "wrapper": "languages/java/wrapper.java",
      "reference": "languages/java/reference.java"
    },
    "cpp": {
      "starter": "languages/cpp/starter.cpp",
      "wrapper": "languages/cpp/wrapper.cpp",
      "reference": "languages/cpp/reference.cpp"
    },
    "python": {
      "starter": "languages/python/starter.py",
      "wrapper": "languages/python/wrapper.py",
      "reference": "languages/python/reference.py"
    }
  },
  "sourceIds": [
    "codewise2-original"
  ],
  "checkpointIds": [
    "linked-list-18",
    "linked-list-19",
    "linked-list-15"
  ],
  "remedialIds": [
    "linked-list-01",
    "linked-list-03"
  ],
  "nextIds": [
    "linked-list-10"
  ],
  "rationale": "A node keeps its original identifier after moving; detach its current predecessor link before connecting it at the new location.",
  "commonMistakes": [
    "interpret-identifiers-as-current-positions",
    "ignore-all-moves"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
    "outputBytes": 4194304,
    "fileKb": 4096,
    "inputBytes": 8388608
  },
  "semanticConstraints": [
    {
      "kind": "lengths-equal",
      "left": "cutIds",
      "right": "afterIds"
    },
    {
      "kind": "range-by-length",
      "field": "cutIds",
      "array": "head",
      "minimum": 0,
      "maxOffset": -1
    },
    {
      "kind": "range-by-length",
      "field": "afterIds",
      "array": "head",
      "minimum": -1,
      "maxOffset": -1
    }
  ]
}
