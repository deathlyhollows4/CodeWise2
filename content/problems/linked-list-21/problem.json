{
  "schemaVersion": 1,
  "id": "linked-list-21",
  "version": "1.0.0",
  "slug": "balanced-native-list-parts",
  "title": "Split original nodes into balanced consecutive parts",
  "primaryTopic": "linked-list",
  "skillIds": [
    "list.balanced-part-boundaries",
    "list.native-head-array"
  ],
  "prerequisites": [
    "list.walk",
    "list.link-splice",
    "list.original-identity"
  ],
  "step": 4,
  "status": "published",
  "objective": "Return k native heads whose disjoint consecutive chains preserve original node order, with earlier parts receiving any remainder.",
  "constraints": [
    "0 ≤ node count ≤ 2,000; 1 ≤ k ≤ 2,000.",
    "Node values lie in [-1,000,000,1,000,000].",
    "Return exactly k parts, with earlier parts longer when n is not divisible by k.",
    "No original node appears in two parts; concatenating parts restores original node order."
  ],
  "interface": "Solution.solve(head,k) returns native head array/list; ListNodeIdentityParts serializes original indexes.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "head": {
        "kind": "array",
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "k": {
        "kind": "integer",
        "minimum": 1,
        "maximum": 2000
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "minLength": 1,
    "maxLength": 2000,
    "items": {
      "kind": "array",
      "maxLength": 2000,
      "items": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 1999
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
