  "status": "published",
  "objective": "Find the maximum signed total of a nonempty simple path between any two nodes, discarding harmful child branches without allowing an empty result.",
  "constraints": [
    "0 ≤ native node count ≤ 2,000.",
    "Node values lie in [-1,000,000,000,1,000,000,000].",
    "The input is a finite binary tree; sparse children, duplicate values and deep chains are allowed.",
    "Do not modify original node values or links.",
    "A nonempty input requires a nonempty path; only an empty input returns the empty-tree value zero.",
    "Return a signed wide integer; a 2,000-node positive chain can total 2,000,000,000,000."
  ],
  "interface": "Solution.solve(root) returns long / long long.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "root": {
        "kind": "array",
        "maxLength": 4001,
        "trimTrailingNulls": true,
        "items": {
          "kind": "nullable",
          "value": {
            "kind": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": -1000000000,
    "maximum": 2000000000000
