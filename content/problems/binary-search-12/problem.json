  "step": 6,
  "status": "published",
  "objective": "Choose k distinct positions so the smallest distance between neighboring chosen positions is as large as possible.",
  "constraints": [
    "2 <= positions.length <= 100000",
    "positions is strictly increasing",
    "-1000000000 <= positions[i] <= 1000000000",
    "2 <= k <= positions.length",
    "0 <= answer <= 2000000000"
  ],
  "interface": "Solution.solve(positions,k) returns the maximum integer minimum gap.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "positions": {
        "kind": "array",
        "minLength": 2,
        "maxLength": 100000,
        "items": {
          "kind": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      },
      "k": {
        "kind": "integer",
        "minimum": 2,
        "maximum": 100000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": 0,
    "maximum": 2000000000
  },
