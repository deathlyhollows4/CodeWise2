{
  "schemaVersion": 1,
  "id": "linked-list-03",
  "version": "1.0.0",
  "slug": "kth-from-end-original-node",
  "title": "Return the original kth node from the end",
  "primaryTopic": "linked-list",
  "skillIds": [
    "list.fixed-node-gap",
    "list.original-identity"
  ],
  "prerequisites": [
    "list.walk"
  ],
  "step": 2,
  "status": "published",
  "objective": "Locate a node with a fixed gap between traversal cursors and return its original identity rather than a copy with an equal value.",
  "constraints": [
    "0 ≤ head.length ≤ 2,000",
    "1 ≤ k ≤ 2,001",
    "Values lie in [-1,000,000,1,000,000]; values may all be equal."
  ],
  "interface": "Solution.solve(head, k) returns an original ListNode or null; the wrapper reports its original index.",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "head": {
        "kind": "array",
        "maxLength": 2000,
        "items": {
          "kind": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "k": {
        "kind": "integer",
        "minimum": 1,
        "maximum": 2001
      }
    }
  },
  "outputSchema": {
    "kind": "nullable",
    "value": {
      "kind": "integer",
      "minimum": 0,
      "maximum": 1999
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
