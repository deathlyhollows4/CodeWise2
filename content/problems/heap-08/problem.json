        "items": {
          "kind": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      },
      "cooldown": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 1000000000
      }
    }
  },
  "outputSchema": {
    "kind": "integer",
    "minimum": 0,
    "maximum": 100000000000000
  },
