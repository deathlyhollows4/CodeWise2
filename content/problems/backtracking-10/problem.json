  "step": 5,
  "status": "published",
  "objective": "Enumerate all original-task orders feasible under release times, durations and inclusive deadlines, pruning failed prefixes.",
  "constraints": [
    "0 ≤ release.length = duration.length = deadline.length ≤ 7.",
    "Release times lie in [0,1,000,000,000].",
    "Durations lie in [1,1,000,000,000].",
    "Deadlines lie in [0,8,000,000,000]; impossible deadlines are valid input.",
    "No preemption or parallel execution is allowed.",
    "At most 7! = 5,040 task orders exist; all answer rows include every original ID once."
  ],
  "interface": "Solution.solve(release:long[],duration:long[],deadline:long[]) returns lexicographically ordered int[][].",
  "inputSchema": {
    "kind": "object",
    "properties": {
      "release": {
        "kind": "array",
        "maxLength": 7,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "duration": {
        "kind": "array",
        "maxLength": 7,
        "items": {
          "kind": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      },
      "deadline": {
        "kind": "array",
        "maxLength": 7,
        "items": {
          "kind": "integer",
          "minimum": 0,
          "maximum": 8000000000
        }
      }
    }
  },
  "outputSchema": {
    "kind": "array",
    "maxLength": 5040,
    "items": {
      "kind": "array",
      "maxLength": 7,
      "items": {
        "kind": "integer",
        "minimum": 0,
        "maximum": 6
      }
    }
  },
  "checker": {
    "kind": "exact"
  },
  "harness": {
    "encoding": "json-lines-v1"
  },
