  "rationale": "Visit native neighbor links and assign an index when a node identity first appears. Values are not identities.",
  "commonMistakes": [
    "boolean-edges",
    "identify-nodes-by-value"
  ],
  "limits": {
    "cpuSeconds": 5,
    "wallSeconds": 15,
    "memoryKb": 262144,
    "processes": 64,
    "outputBytes": 4194304,
    "fileKb": 4096,
    "inputBytes": 8388608
  },
  "semanticConstraints": [
    {
      "kind": "node-table",
      "field": "graph",
      "neighbors": "neighbors",
      "root": "root",
      "requireReachable": true
    }
  ]
